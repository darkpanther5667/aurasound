# AuraSound Gateway Environment Configuration
PORT=4000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/aurasound?schema=public"

# YouTube Extraction Microservice (Internal URL)
EXTRACTION_SERVICE_URL="http://127.0.0.1:4001"

# Allowed CORS Origins (Comma-separated for frontend domains)
CORS_ORIGIN="https://your-app.vercel.app,http://localhost:5173"

# JWT Secret for Auth sessions
JWT_SECRET="generate-a-secure-random-secret-here"
