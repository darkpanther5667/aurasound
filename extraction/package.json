{
  "name": "aurasound-extraction-service",
  "version": "1.0.0",
  "description": "Internal YouTube Audio Stream Extraction Microservice for AuraSound",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run install-ytdlp",
    "install-ytdlp": "mkdir -p $HOME/.local/bin && curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o $HOME/.local/bin/yt-dlp && chmod +x $HOME/.local/bin/yt-dlp && echo 'yt-dlp installed:' && $HOME/.local/bin/yt-dlp --version",
    "start": "export PATH=$HOME/.local/bin:$PATH && node dist/index.js"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "typescript": "^5.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
